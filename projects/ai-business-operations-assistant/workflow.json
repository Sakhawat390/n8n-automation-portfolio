    {
      "parameters": {
        "sendTo": "={{ $json['Employee Email'] }}",
        "subject": "AI Business Operations Analysis Report",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:30px 15px;background:#f4f7fb;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\"\nstyle=\"max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;\">\n\n<tr>\n<td style=\"background:#111827;padding:25px 30px;color:#ffffff;\">\n<h1 style=\"margin:0;font-size:24px;\">Business Operations Analysis</h1>\n<p style=\"margin:8px 0 0;color:#d1d5db;font-size:14px;\">\nAI-generated business request report\n</p>\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:30px;\">\n\n<h2 style=\"margin:0 0 20px;font-size:18px;\">Request Information</h2>\n\n<table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"font-size:14px;\">\n<tr>\n<td><strong>Employee</strong></td>\n<td>{{ $json['Employee Name'] }}</td>\n</tr>\n\n<tr>\n<td><strong>Email</strong></td>\n<td>{{ $json['Employee Email'] }}</td>\n</tr>\n</table>\n\n<hr style=\"border:0;border-top:1px solid #e5e7eb;margin:25px 0;\">\n\n<h3 style=\"font-size:16px;\">Priority</h3>\n\n<div style=\"background:#f3f4f6;border-left:4px solid #2563eb;padding:14px;\">\n<p style=\"margin:0;font-size:15px;font-weight:bold;\">\n{{ JSON.parse($('AI Business Analyst').item.json.output).priority }}\n</p>\n</div>\n\n<h3 style=\"font-size:16px;\">Business Request</h3>\n\n<div style=\"background:#f9fafb;padding:15px;border-radius:6px;\">\n<p style=\"margin:0;font-size:14px;line-height:23px;color:#4b5563;\">\n{{ $json['Business Request'] }}\n</p>\n</div>\n\n<h3 style=\"font-size:16px;\">Summary</h3>\n<p style=\"font-size:14px;line-height:24px;color:#4b5563;\">\n{{ JSON.parse($('AI Business Analyst').item.json.output).summary }}\n</p>\n\n<h3 style=\"font-size:16px;\">Important Information</h3>\n<p style=\"font-size:14px;line-height:24px;color:#4b5563;\">\n{{ JSON.parse($('AI Business Analyst').item.json.output).important_information }}\n</p>\n\n<h3 style=\"font-size:16px;\">Recommended Action</h3>\n\n<div style=\"background:#f3f4f6;border-left:4px solid #2563eb;padding:15px;\">\n<p style=\"margin:0;font-size:14px;line-height:24px;color:#374151;\">\n{{ JSON.parse($('AI Business Analyst').item.json.output).recommended_action }}\n</p>\n</div>\n\n<h3 style=\"font-size:16px;\">Next Steps</h3>\n<p style=\"font-size:14px;line-height:24px;color:#4b5563;\">\n{{ JSON.parse($('AI Business Analyst').item.json.output).next_steps }}\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#f9fafb;padding:18px 30px;text-align:center;\">\n<p style=\"margin:0;font-size:12px;color:#9ca3af;\">\nAI Business Operations Assistant\n</p>\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
