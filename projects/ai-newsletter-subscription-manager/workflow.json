    {
      "parameters": {
        "sendTo": "={{ $('On form submission').item.json['Email Address'] }}",
        "subject": "Welcome to Sakhawat NES Newsletter",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Welcome to Sakhawat NES Newsletter</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f4f7fb; font-family:Arial,Helvetica,sans-serif; color:#1f2937;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f7fb; padding:30px 15px;\">\n    <tr>\n      <td align=\"center\">\n\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff; border-radius:14px; overflow:hidden;\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#111827; padding:32px 30px; text-align:center;\">\n              <div style=\"font-size:13px; letter-spacing:2px; color:#9ca3af; text-transform:uppercase;\">\n                Sakhawat NES\n              </div>\n\n              <h1 style=\"margin:10px 0 0; color:#ffffff; font-size:28px; line-height:36px;\">\n                Welcome to the Newsletter\n              </h1>\n            </td>\n          </tr>\n\n          <!-- Main Content -->\n          <tr>\n            <td style=\"padding:35px 32px;\">\n\n              <p style=\"margin:0 0 18px; font-size:17px; line-height:28px;\">\n                Hello <strong>{{ $json[\"Full name\"] }}</strong>,\n              </p>\n\n              <p style=\"margin:0 0 18px; font-size:15px; line-height:26px; color:#4b5563;\">\n                Thank you for subscribing to the Sakhawat NES Newsletter.\n                We're glad to have you with us.\n              </p>\n\n              <p style=\"margin:0 0 25px; font-size:15px; line-height:26px; color:#4b5563;\">\n                You'll receive useful updates, insights, technology-related\n                content, and other valuable information directly in your inbox.\n              </p>\n\n              <!-- Highlight Box -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:25px 0;\">\n                <tr>\n                  <td style=\"background-color:#f3f4f6; border-left:4px solid #2563eb; padding:18px 20px;\">\n                    <p style=\"margin:0; font-size:14px; line-height:23px; color:#374151;\">\n                      <strong>You're officially subscribed.</strong><br>\n                      Keep an eye on your inbox for our upcoming newsletter.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- CTA -->\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:28px auto 10px;\">\n                <tr>\n                  <td align=\"center\" style=\"background-color:#2563eb; border-radius:8px;\">\n                    <span style=\"display:inline-block; padding:14px 26px; color:#ffffff; font-size:14px; font-weight:bold;\">\n                      Stay Connected\n                    </span>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin:28px 0 0; font-size:14px; line-height:24px; color:#6b7280; text-align:center;\">\n                Thanks for joining us.\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f9fafb; padding:22px 30px; text-align:center; border-top:1px solid #e5e7eb;\">\n              <p style=\"margin:0 0 7px; font-size:13px; font-weight:bold; color:#374151;\">\n                Sakhawat NES Newsletter\n              </p>\n\n              <p style=\"margin:0; font-size:12px; line-height:20px; color:#9ca3af;\">\n                You're receiving this email because you subscribed to our newsletter.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
