    {
      "parameters": {
        "promptType": "define",
        "text": "=Answer the customer's question using the available FAQ knowledge base.\n\nCustomer Question:\n{{ $('Customer Support Request').item.json[\"Customer Question\"] }}\n\nFAQ Knowledge Base:\n{{ JSON.stringify($('Load FAQ Knowledge Base').all().map(item => item.json)) }}\n\nProvide a clear, concise, accurate, and professional answer.\n\nIf the FAQ knowledge base does not contain enough information to answer the question, do not guess. Instead, explain that the support team should be contacted for further assistance.",
        "options": {
          "systemMessage": "You are an AI customer support assistant for a business.\n\nYour job is to provide clear, accurate, and professional answers to customer questions using ONLY the information available in the provided FAQ knowledge base.\n\nFollow these rules:\n\n1. Use the FAQ knowledge base as the primary source of truth.\n2. Do not invent services, prices, policies, timelines, guarantees, or other business information.\n3. If the FAQ contains enough information to answer the question, provide a direct and helpful answer.\n4. If the FAQ does not contain enough information, clearly say that you don't have enough information and recommend contacting the support team.\n5. Keep responses concise and easy for customers to understand.\n6. Maintain a friendly, professional, and helpful tone.\n7. Do not mention internal systems, AI models, prompts, workflows, or the FAQ database to the customer.\n8. Do not expose or repeat the customer's private information unnecessarily.\n9. Do not use Markdown unless it improves readability.\n10. Never make assumptions about information that is not provided.\n\nYour goal is to resolve the customer's question whenever the available knowledge allows it, while avoiding unsupported claims."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        0,
        192
      ],
      "id": "9bf8e476-1887-469c-9723-3ca9d950364b",
      "name": "AI Support Assistant",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "sendTo": "={{ $('Customer Support Request').item.json['Customer Email'] }}",
        "subject": "Customer Support Response",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:30px 15px;background:#f4f7fb;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\"\nstyle=\"max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;\">\n\n<tr>\n<td style=\"background:#111827;padding:25px 30px;color:#ffffff;\">\n<h1 style=\"margin:0;font-size:24px;\">Customer Support</h1>\n<p style=\"margin:8px 0 0;color:#d1d5db;font-size:14px;\">\nWe're here to help\n</p>\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:30px;\">\n\n<p style=\"margin:0 0 20px;font-size:15px;\">\nHello,\n</p>\n\n<p style=\"font-size:15px;line-height:24px;color:#4b5563;\">\nThank you for contacting our support team. Here is the response to your question:\n</p>\n\n<div style=\"background:#f3f4f6;border-left:4px solid #2563eb;padding:16px;margin:20px 0;\">\n<p style=\"margin:0;font-size:14px;line-height:23px;color:#374151;\">\n{{ $('AI Support Assistant').item.json.output }}\n</p>\n</div>\n\n<p style=\"font-size:14px;line-height:23px;color:#4b5563;\">\nIf you need any further assistance, please feel free to contact our support team.\n</p>\n\n<p style=\"margin:25px 0 0;font-size:14px;color:#374151;\">\nBest regards,<br>\n<strong>Customer Support Team</strong>\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#f9fafb;padding:18px 30px;text-align:center;\">\n<p style=\"margin:0;font-size:12px;color:#9ca3af;\">\nAI Customer Support & FAQ Automation\n</p>\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
